{
  "name": "Ridgeline Blueprint",
  "dataColors": ["#1B2A4A", "#F2A93B", "#2A9D8F", "#5DADE2", "#8E9AAF", "#D64545", "#7B61FF", "#3D5A80"],
  "background": "#FFFFFF",
  "foreground": "#1B2A4A",
  "tableAccent": "#F2A93B",
  "good": "#2E9E6A",
  "neutral": "#F2A93B",
  "bad": "#D64545",
  "maximum": "#1B2A4A",
  "center": "#DCE6F2",
  "minimum": "#FFFFFF",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1B2A4A" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1B2A4A" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4A5873" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1B2A4A" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#EEF2F7" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#DCE3EC" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": false, "radius": 10 }],
        "dropShadow": [{
          "show": true, "color": { "solid": { "color": "#0B1F3A" } }, "position": "Outer", "preset": "Custom",
          "shadowSpread": 0, "shadowBlur": 12, "angle": 90, "shadowDistance": 3, "transparency": 88
        }],
        "title": [{ "fontColor": { "solid": { "color": "#1B2A4A" } }, "fontFamily": "Segoe UI Semibold" }],
        "subTitle": [{ "fontColor": { "solid": { "color": "#6B7A93" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#1B2A4A" } }, "fontFamily": "Segoe UI Semibold" }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#1B2A4A" } }, "fontFamily": "Segoe UI Semibold" }],
        "dropShadow": [{ "show": false }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#1B2A4A" } }, "backColor": { "solid": { "color": "#E8EEF6" } },
          "fontFamily": "Segoe UI Semibold"
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#1B2A4A" } }, "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "fontColorSecondary": { "solid": { "color": "#1B2A4A" } }, "backColorSecondary": { "solid": { "color": "#F6F8FB" } }
        }],
        "total": [{ "fontColor": { "solid": { "color": "#1B2A4A" } }, "backColor": { "solid": { "color": "#FDF3E1" } } }],
        "grid": [{ "outlineColor": { "solid": { "color": "#F2A93B" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#1B2A4A" } }, "backColor": { "solid": { "color": "#E8EEF6" } },
          "fontFamily": "Segoe UI Semibold"
        }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#1B2A4A" } } }],
        "total": [{ "fontColor": { "solid": { "color": "#1B2A4A" } }, "backColor": { "solid": { "color": "#FDF3E1" } } }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    }
  }
}
