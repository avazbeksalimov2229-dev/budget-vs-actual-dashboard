{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "p5_forecast",
  "displayName": "Forecast Check",
  "displayOption": "FitToPage",
  "height": 720,
  "width": 1280,
  "objects": {
    "background": [
      {
        "properties": {
          "image": {
            "image": {
              "name": {
                "expr": {
                  "Literal": {
                    "Value": "'background'"
                  }
                }
              },
              "url": {
                "expr": {
                  "ResourcePackageItem": {
                    "PackageName": "RegisteredResources",
                    "PackageType": 1,
                    "ItemName": "background_blueprint.png"
                  }
                }
              },
              "scaling": {
                "expr": {
                  "Literal": {
                    "Value": "'Fit'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0.0D"
              }
            }
          }
        }
      }
    ]
  },
  "visualInteractions": [
    {
      "source": "sl_asof",
      "target": "creep",
      "type": "NoFilter"
    },
    {
      "source": "sl_creep",
      "target": "k_eac",
      "type": "NoFilter"
    },
    {
      "source": "sl_creep",
      "target": "k_eac_cpi",
      "type": "NoFilter"
    },
    {
      "source": "sl_creep",
      "target": "k_gap",
      "type": "NoFilter"
    },
    {
      "source": "sl_creep",
      "target": "k_cpi",
      "type": "NoFilter"
    },
    {
      "source": "sl_creep",
      "target": "k_pending",
      "type": "NoFilter"
    },
    {
      "source": "sl_creep",
      "target": "k_open",
      "type": "NoFilter"
    },
    {
      "source": "sl_creep",
      "target": "eac_compare",
      "type": "NoFilter"
    },
    {
      "source": "sl_creep",
      "target": "gap_table",
      "type": "NoFilter"
    }
  ]
}
