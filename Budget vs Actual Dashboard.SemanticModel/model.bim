{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "sourceQueryCulture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "dim_project",
        "columns": [
          {
            "name": "project_id",
            "dataType": "string",
            "sourceColumn": "project_id",
            "summarizeBy": "none"
          },
          {
            "name": "project_name",
            "dataType": "string",
            "sourceColumn": "project_name",
            "summarizeBy": "none"
          },
          {
            "name": "client",
            "dataType": "string",
            "sourceColumn": "client",
            "summarizeBy": "none"
          },
          {
            "name": "project_type",
            "dataType": "string",
            "sourceColumn": "project_type",
            "summarizeBy": "none"
          },
          {
            "name": "pm_id",
            "dataType": "string",
            "sourceColumn": "pm_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "start_date",
            "dataType": "dateTime",
            "sourceColumn": "start_date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none"
          },
          {
            "name": "planned_finish",
            "dataType": "dateTime",
            "sourceColumn": "planned_finish",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none"
          },
          {
            "name": "original_contract_value",
            "dataType": "decimal",
            "sourceColumn": "original_contract_value",
            "formatString": "\\$#,0",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "project_label",
            "dataType": "string",
            "sourceColumn": "project_label",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_project",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"projects.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {",
                "        {\"project_id\", type text}, {\"project_name\", type text}, {\"client\", type text}, {\"project_type\", type text},",
                "        {\"pm_id\", type text}, {\"start_date\", type date}, {\"planned_finish\", type date},",
                "        {\"original_contract_value\", Currency.Type}, {\"status\", type text}}, \"en-US\"),",
                "    Label = Table.AddColumn(Typed, \"project_label\", each [project_id] & \" \" & [project_name], type text)",
                "in",
                "    Label"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_pm",
        "columns": [
          {
            "name": "pm_id",
            "dataType": "string",
            "sourceColumn": "pm_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "pm_name",
            "dataType": "string",
            "sourceColumn": "pm_name",
            "summarizeBy": "none"
          },
          {
            "name": "pm_email",
            "dataType": "string",
            "sourceColumn": "pm_email",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_pm",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"project_managers.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"pm_id\", type text}, {\"pm_name\", type text}, {\"pm_email\", type text}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_cost_code",
        "columns": [
          {
            "name": "cost_code",
            "dataType": "string",
            "sourceColumn": "cost_code",
            "summarizeBy": "none"
          },
          {
            "name": "cost_code_name",
            "dataType": "string",
            "sourceColumn": "cost_code_name",
            "summarizeBy": "none",
            "sortByColumn": "sort_order"
          },
          {
            "name": "cost_category",
            "dataType": "string",
            "sourceColumn": "cost_category",
            "summarizeBy": "none"
          },
          {
            "name": "sort_order",
            "dataType": "int64",
            "sourceColumn": "sort_order",
            "formatString": "0",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "cost_code_label",
            "dataType": "string",
