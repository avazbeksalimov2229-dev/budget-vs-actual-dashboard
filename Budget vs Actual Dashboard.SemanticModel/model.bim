            "sourceColumn": "forecast_month",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "forecast_to_complete",
            "dataType": "decimal",
            "sourceColumn": "forecast_to_complete",
            "formatString": "\\$#,0",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "note",
            "dataType": "string",
            "sourceColumn": "note",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_forecast",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Tables = Table.AddColumn(pm_workbooks, \"Data\", each",
                "        Table.SelectRows([Workbook], each [Kind] = \"Table\" and [Item] = \"tblForecast\"){0}[Data]),",
                "    Combined = Table.Combine(Tables[Data]),",
                "    NotBlank = Table.SelectRows(Combined, each [project_id] <> null and [cost_code] <> null and [forecast_month] <> null),",
                "    Ids = Table.TransformColumns(NotBlank, {",
                "        {\"project_id\", each Text.Upper(Text.Trim(Text.From(_))), type text},",
                "        {\"cost_code\", each Text.Trim(Text.From(_)), type text}}),",
                "    Typed = Table.TransformColumnTypes(Ids, {",
                "        {\"forecast_month\", type date}, {\"forecast_to_complete\", Currency.Type}, {\"note\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_date",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Date",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Date]",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd",
            "isKey": true
          },
          {
            "type": "calculatedTableColumn",
            "name": "Year",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Year]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Quarter",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Quarter]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Year Quarter",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Year Quarter]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Month Number",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Month Number]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Month",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Month]",
            "summarizeBy": "none",
            "sortByColumn": "Month Number"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Year Month",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Year Month]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Month Start",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Month Start]",
            "summarizeBy": "none",
            "formatString": "mmm yyyy"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Month End",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Month End]",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Is Closed Month",
            "dataType": "boolean",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Is Closed Month]",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_date",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ADDCOLUMNS (\n    CALENDAR ( DATE ( 2024, 7, 1 ), DATE ( 2027, 12, 31 ) ),\n    \"Year\", YEAR ( [Date] ),\n    \"Quarter\", \"Q\" & QUARTER ( [Date] ),\n    \"Year Quarter\", YEAR ( [Date] ) & \"-Q\" & QUARTER ( [Date] ),\n    \"Month Number\", MONTH ( [Date] ),\n    \"Month\", FORMAT ( [Date], \"MMM\" ),\n    \"Year Month\", FORMAT ( [Date], \"YYYY-MM\" ),\n    \"Month Start\", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),\n    \"Month End\", EOMONTH ( [Date], 0 ),\n    -- months that already have actuals: used to filter the as-of slicer and the trend charts\n    \"Is Closed Month\", EOMONTH ( [Date], 0 ) <= EOMONTH ( MAX ( fact_actuals[posting_date] ), 0 )\n)"
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "board_points",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Point",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Point]",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "board_points",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "SELECTCOLUMNS ( GENERATESERIES ( 1, 3, 1 ), \"Point\", [Value] )"
            }
          }
        ],
        "isHidden": true
      },
      {
        "name": "View By",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "View By",
            "dataType": "string",
            "isNameInferred": false,
            "isDataTypeInferred": true,
            "sourceColumn": "[Value1]",
            "sortByColumn": "View By Order",
            "summarizeBy": "none",
            "relatedColumnDetails": {
              "groupByColumns": [
                {
                  "groupingColumn": "View By Fields"
                }
              ]
            }
          },
          {
            "type": "calculatedTableColumn",
            "name": "View By Fields",
            "dataType": "string",
            "isNameInferred": false,
            "isDataTypeInferred": true,
            "sourceColumn": "[Value2]",
            "sortByColumn": "View By Order",
            "summarizeBy": "none",
            "isHidden": true,
            "extendedProperties": [
              {
                "type": "json",
                "name": "ParameterMetadata",
                "value": {
                  "version": 3,
                  "kind": 2
                }
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "View By Order",
            "dataType": "int64",
            "isNameInferred": false,
            "isDataTypeInferred": true,
            "sourceColumn": "[Value3]",
            "summarizeBy": "sum",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "View By",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "{\n    ( \"Project\", NAMEOF ( dim_project[project_id] ), 0 ),\n    ( \"Project manager\", NAMEOF ( dim_pm[pm_name] ), 1 ),\n    ( \"Project type\", NAMEOF ( dim_project[project_type] ), 2 ),\n    ( \"Cost category\", NAMEOF ( dim_cost_code[cost_category] ), 3 )\n}"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Placeholder",
            "dataType": "string",
            "sourceColumn": "Placeholder",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(type table [Placeholder = text], {})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Data Through",
            "expression": "EOMONTH ( CALCULATE ( MAX ( fact_actuals[posting_date] ), REMOVEFILTERS () ), 0 )",
            "formatString": "d mmm yyyy",
            "displayFolder": "0 As of"
          },
          {
            "name": "As Of Date",
            "expression": "MIN ( MAX ( dim_date[Date] ), [Data Through] )",
            "formatString": "d mmm yyyy",
            "displayFolder": "0 As of"
          },
          {
            "name": "Is Future Period",
            "expression": "MIN ( dim_date[Date] ) > [Data Through]",
            "displayFolder": "0 As of"
          },
          {
            "name": "As Of Label",
            "expression": "\"Data as of \" & FORMAT ( [As Of Date], \"d mmm yyyy\" )",
            "displayFolder": "0 As of"
          },
          {
            "name": "Original Budget",
            "expression": "CALCULATE ( SUM ( fact_budget[amount] ), fact_budget[budget_type] = \"Original\", REMOVEFILTERS ( dim_date ) )",
            "formatString": "\\$#,0",
            "displayFolder": "1 Cost"
          },
          {
            "name": "Approved CO Cost",
            "expression": [
              "VAR d = [As Of Date]",
              "RETURN",
              "    CALCULATE (",
              "        SUM ( fact_change_orders[cost_amount] ),",
              "        fact_change_orders[status] = \"Approved\",",
              "        REMOVEFILTERS ( dim_date ),",
              "        fact_change_orders[approved_date] <= d",
              "    ) + 0"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "1 Cost"
          },
          {
            "name": "Revised Budget",
            "expression": "[Original Budget] + [Approved CO Cost]",
            "formatString": "\\$#,0",
            "displayFolder": "1 Cost"
          },
          {
            "name": "Planned Cost (month)",
            "expression": "SUM ( fact_budget[amount] )",
            "formatString": "\\$#,0",
            "displayFolder": "1 Cost"
          },
          {
            "name": "Planned Value",
            "expression": [
              "VAR d = MAX ( dim_date[Date] )",
              "VAR lastPlanMonth = EOMONTH ( CALCULATE ( MAX ( fact_budget[month_start] ), REMOVEFILTERS ( dim_date ) ), 0 )",
              "RETURN",
              "    IF (",
              "        MIN ( dim_date[Date] ) <= lastPlanMonth,",
              "        CALCULATE ( SUM ( fact_budget[amount] ), REMOVEFILTERS ( dim_date ), fact_budget[month_start] <= d )",
              "    )"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "1 Cost"
          },
          {
            "name": "Actual Cost (month)",
            "expression": "IF ( NOT [Is Future Period], SUM ( fact_actuals[amount] ) )",
            "formatString": "\\$#,0",
            "displayFolder": "1 Cost"
          },
          {
            "name": "Actual Cost",
            "expression": [
              "VAR d = [As Of Date]",
              "RETURN",
              "    IF (",
              "        NOT [Is Future Period],",
              "        CALCULATE ( SUM ( fact_actuals[amount] ), REMOVEFILTERS ( dim_date ), fact_actuals[posting_date] <= d )",
              "    )"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "1 Cost"
          },
          {
            "name": "Committed Cost",
            "expression": [
              "VAR d = [As Of Date]",
              "RETURN",
              "    CALCULATE ( SUM ( fact_commitments[amount] ), REMOVEFILTERS ( dim_date ), fact_commitments[commitment_date] <= d )"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "1 Cost"
          },
          {
            "name": "Invoiced on Commitments",
            "expression": [
              "VAR d = [As Of Date]",
              "RETURN",
              "    CALCULATE (",
              "        SUM ( fact_actuals[amount] ),",
              "        REMOVEFILTERS ( dim_date ),",
              "        fact_actuals[posting_date] <= d,",
              "        NOT ISBLANK ( fact_actuals[po_id] )",
              "    )"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "1 Cost"
          },
          {
            "name": "Open Commitments",
            "expression": [
              "SUMX (",
              "    CROSSJOIN ( VALUES ( dim_project[project_id] ), VALUES ( dim_cost_code[cost_code] ) ),",
              "    MAX ( 0, [Committed Cost] - [Invoiced on Commitments] )",
              ")"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "1 Cost"
          },
          {
            "name": "Committed Over Budget",
            "expression": [
              "SUMX (",
              "    CROSSJOIN ( VALUES ( dim_project[project_id] ), VALUES ( dim_cost_code[cost_code] ) ),",
              "    VAR over = [Committed Cost] - [Revised Budget]",
              "    RETURN IF ( over > 0, over )",
              ")"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "1 Cost"
          },
          {
            "name": "Committed % of Budget",
            "expression": "DIVIDE ( [Committed Cost], [Revised Budget] )",
            "formatString": "0.0%",
            "displayFolder": "1 Cost"
          },
          {
            "name": "Unallocated Cost",
            "expression": "CALCULATE ( [Actual Cost], dim_cost_code[cost_code] = \"99-999\" )",
            "formatString": "\\$#,0",
            "displayFolder": "1 Cost"
          },
          {
            "name": "Earned Value",
            "expression": [
              "VAR d = [As Of Date]",
              "RETURN",
              "    IF (",
              "        NOT [Is Future Period],",
              "        SUMX (",
              "            VALUES ( dim_project[project_id] ),",
              "            VAR lastWeek =",
              "                CALCULATE ( MAX ( fact_progress[week_ending] ), REMOVEFILTERS ( dim_date ), fact_progress[week_ending] <= d )",
              "            VAR pct =",
              "                CALCULATE ( MAX ( fact_progress[pct_complete] ), REMOVEFILTERS ( dim_date ), fact_progress[week_ending] = lastWeek )",
              "            RETURN pct * [Revised Budget]",
              "        )",
              "    )"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "2 Earned value"
          },
          {
            "name": "% Complete",
            "expression": "DIVIDE ( [Earned Value], [Revised Budget] )",
            "formatString": "0.0%",
            "displayFolder": "2 Earned value"
          },
          {
            "name": "CPI",
            "expression": "DIVIDE ( [Earned Value], [Actual Cost] )",
            "formatString": "0.00",
            "displayFolder": "2 Earned value"
          },
          {
            "name": "SPI",
            "expression": [
              "VAR d = [As Of Date]",
              "VAR pv = CALCULATE ( SUM ( fact_budget[amount] ), REMOVEFILTERS ( dim_date ), fact_budget[month_start] <= d )",
              "RETURN DIVIDE ( [Earned Value], pv )"
            ],
            "formatString": "0.00",
            "displayFolder": "2 Earned value"
          },
          {
            "name": "Cost Variance (EV - AC)",
            "expression": "[Earned Value] - [Actual Cost]",
            "formatString": "\\$#,0",
            "displayFolder": "2 Earned value"
          },
          {
            "name": "Forecast to Complete",
            "expression": [
              "VAR d = [As Of Date]",
              "RETURN",
              "    SUMX (",
              "        VALUES ( dim_project[project_id] ),",
              "        VAR snap =",
              "            CALCULATE (",
              "                MAX ( fact_forecast[forecast_month] ),",
              "                REMOVEFILTERS ( dim_date ),",
              "                REMOVEFILTERS ( dim_cost_code ),",
              "                fact_forecast[forecast_month] <= d",
              "            )",
              "        RETURN",
              "            CALCULATE ( SUM ( fact_forecast[forecast_to_complete] ), REMOVEFILTERS ( dim_date ), fact_forecast[forecast_month] = snap )",
              "    )"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "3 Forecast"
          },
          {
            "name": "EAC",
            "expression": "IF ( NOT [Is Future Period], [Actual Cost] + [Forecast to Complete] )",
            "formatString": "\\$#,0",
            "displayFolder": "3 Forecast"
          },
          {
            "name": "EAC (CPI Trend)",
            "expression": [
              "SUMX (",
              "    VALUES ( dim_project[project_id] ),",
              "    VAR ac = [Actual Cost]",
              "    VAR ev = [Earned Value]",
              "    VAR bac = [Revised Budget]",
              "    VAR cpi = DIVIDE ( ev, ac )",
              "    RETURN IF ( ISBLANK ( cpi ) || DIVIDE ( ev, bac ) < 0.2, [EAC], ac + DIVIDE ( bac - ev, cpi ) )",
              ")"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "3 Forecast"
          },
          {
            "name": "Variance at Completion",
            "expression": "[Revised Budget] - [EAC]",
            "formatString": "\\$#,0",
            "displayFolder": "3 Forecast"
          },
          {
            "name": "Variance at Completion %",
            "expression": "DIVIDE ( [Variance at Completion], [Revised Budget] )",
            "formatString": "0.0%",
            "displayFolder": "3 Forecast"
          },
          {
            "name": "Overrun vs Budget",
            "expression": "[EAC] - [Revised Budget]",
            "formatString": "\\$#,0",
            "displayFolder": "3 Forecast"
          },
          {
            "name": "Overrun (CPI Trend)",
            "expression": "[EAC (CPI Trend)] - [Revised Budget]",
            "formatString": "\\$#,0",
            "displayFolder": "3 Forecast"
          },
          {
            "name": "Revised Budget (Trend)",
            "expression": "IF ( NOT ISBLANK ( [EAC] ), [Revised Budget] )",
            "formatString": "\\$#,0",
            "displayFolder": "3 Forecast"
          },
          {
            "name": "Forecast Gap",
            "expression": "[EAC (CPI Trend)] - [EAC]",
            "formatString": "\\$#,0",
            "displayFolder": "3 Forecast"
          },
          {
            "name": "Pending CO Cost",
            "expression": [
              "VAR d = [As Of Date]",
              "RETURN",
              "    CALCULATE (",
              "        SUM ( fact_change_orders[cost_amount] ),",
              "        REMOVEFILTERS ( dim_date ),",
              "        fact_change_orders[submitted_date] <= d,",
              "        FILTER (",
              "            ALL ( fact_change_orders[status], fact_change_orders[approved_date] ),",
              "            fact_change_orders[status] = \"Pending\"",
              "                || ( fact_change_orders[status] = \"Approved\" && fact_change_orders[approved_date] > d )",
              "        )",
              "    ) + 0"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "3 Forecast"
          },
          {
            "name": "Pending CO Price",
            "expression": [
              "VAR d = [As Of Date]",
              "RETURN",
              "    CALCULATE (",
              "        SUM ( fact_change_orders[price_amount] ),",
              "        REMOVEFILTERS ( dim_date ),",
              "        fact_change_orders[submitted_date] <= d,",
              "        FILTER (",
              "            ALL ( fact_change_orders[status], fact_change_orders[approved_date] ),",
              "            fact_change_orders[status] = \"Pending\"",
              "                || ( fact_change_orders[status] = \"Approved\" && fact_change_orders[approved_date] > d )",
              "        )",
              "    ) + 0"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "3 Forecast"
          },
          {
            "name": "Projects",
            "expression": "COUNTROWS ( VALUES ( dim_project[project_id] ) )",
            "formatString": "#,0",
            "displayFolder": "3 Forecast"
          },
          {
            "name": "Projects Over Budget",
            "expression": "COUNTROWS ( FILTER ( VALUES ( dim_project[project_id] ), [Variance at Completion %] < -0.01 ) ) + 0",
            "formatString": "#,0",
            "displayFolder": "3 Forecast"
          },
          {
            "name": "Original Contract",
            "expression": "SUM ( dim_project[original_contract_value] )",
            "formatString": "\\$#,0",
            "displayFolder": "4 Margin"
          },
          {
            "name": "Approved CO Revenue",
            "expression": [
              "VAR d = [As Of Date]",
              "RETURN",
              "    CALCULATE (",
              "        SUM ( fact_change_orders[price_amount] ),",
              "        fact_change_orders[status] = \"Approved\",",
              "        REMOVEFILTERS ( dim_date ),",
              "        fact_change_orders[approved_date] <= d",
              "    ) + 0"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "4 Margin"
          },
          {
            "name": "Revised Contract",
            "expression": "[Original Contract] + [Approved CO Revenue]",
            "formatString": "\\$#,0",
            "displayFolder": "4 Margin"
          },
          {
            "name": "Original Margin %",
            "expression": "DIVIDE ( [Original Contract] - [Original Budget], [Original Contract] )",
            "formatString": "0.0%",
            "displayFolder": "4 Margin"
          },
          {
            "name": "Projected Gross Profit",
            "expression": "[Revised Contract] - [EAC]",
            "formatString": "\\$#,0",
            "displayFolder": "4 Margin"
          },
          {
            "name": "Projected Margin %",
            "expression": "DIVIDE ( [Projected Gross Profit], [Revised Contract] )",
            "formatString": "0.0%",
            "displayFolder": "4 Margin"
          },
          {
            "name": "Margin Fade (pp)",
            "expression": "( [Projected Margin %] - [Original Margin %] ) * 100",
            "formatString": "+0.0;-0.0;0.0",
            "displayFolder": "4 Margin"
          },
          {
            "name": "Margin Fade Color",
            "expression": "IF ( [Margin Fade (pp)] < 0, \"#D64545\", \"#2E9E6A\" )",
            "displayFolder": "4 Margin"
          },
          {
            "name": "% Complete (Cost-to-Cost)",
            "expression": [
              "SUMX ( VALUES ( dim_project[project_id] ), MIN ( 1, DIVIDE ( [Actual Cost], [EAC] ) ) * [Revised Contract] )",
              "    / [Revised Contract]"
            ],
            "formatString": "0.0%",
            "displayFolder": "5 WIP"
          },
          {
            "name": "Earned Revenue",
            "expression": "SUMX ( VALUES ( dim_project[project_id] ), [Revised Contract] * MIN ( 1, DIVIDE ( [Actual Cost], [EAC] ) ) )",
            "formatString": "\\$#,0",
            "displayFolder": "5 WIP"
          },
          {
            "name": "Billed to Date",
            "expression": [
              "VAR d = [As Of Date]",
              "RETURN",
              "    IF (",
              "        NOT [Is Future Period],",
              "        CALCULATE ( SUM ( fact_billing[billed_amount] ), REMOVEFILTERS ( dim_date ), fact_billing[billing_period_end] <= d )",
              "    )"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "5 WIP"
          },
          {
            "name": "Retention Held",
            "expression": [
              "VAR d = [As Of Date]",
              "RETURN",
              "    CALCULATE ( SUM ( fact_billing[retention_held] ), REMOVEFILTERS ( dim_date ), fact_billing[billing_period_end] <= d )"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "5 WIP"
          },
          {
            "name": "Over (Under) Billing",
            "expression": "[Billed to Date] - [Earned Revenue]",
            "formatString": "\\$#,0",
            "displayFolder": "5 WIP"
          },
          {
            "name": "Overbillings",
            "expression": "SUMX ( VALUES ( dim_project[project_id] ), MAX ( 0, [Over (Under) Billing] ) )",
            "formatString": "\\$#,0",
            "displayFolder": "5 WIP"
          },
          {
            "name": "Underbillings",
            "expression": "SUMX ( VALUES ( dim_project[project_id] ), MAX ( 0, - [Over (Under) Billing] ) )",
            "formatString": "\\$#,0",
            "displayFolder": "5 WIP"
          },
          {
            "name": "Gross Profit to Date",
            "expression": "[Earned Revenue] - [Actual Cost]",
            "formatString": "\\$#,0",
            "displayFolder": "5 WIP"
          },
          {
            "name": "Cash Position",
            "expression": "[Billed to Date] - [Retention Held] - [Actual Cost]",
            "formatString": "\\$#,0",
            "displayFolder": "5 WIP"
          },
          {
            "name": "Cost Status",
            "expression": [
              "VAR vac = [Variance at Completion %]",
              "VAR cpi = [CPI]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( [EAC] ), BLANK (),",
              "        vac < -0.03 || cpi < 0.95, \"Over budget\",",
              "        vac < 0 || cpi < 0.98, \"Watch\",",
              "        \"On budget\"",
              "    )"
            ],
            "displayFolder": "6 Status"
          },
          {
            "name": "Status Color",
            "expression": "SWITCH ( [Cost Status], \"Over budget\", \"#D64545\", \"Watch\", \"#F2A93B\", \"On budget\", \"#2E9E6A\" )",
            "displayFolder": "6 Status"
          },
          {
            "name": "VAC Color",
            "expression": "IF ( [Variance at Completion] < 0, \"#D64545\", \"#2E9E6A\" )",
            "displayFolder": "6 Status"
          },
          {
            "name": "Overrun Color",
            "expression": "IF ( [Overrun vs Budget] > 0, \"#D64545\", \"#2E9E6A\" )",
            "displayFolder": "6 Status"
          },
          {
            "name": "Billing Color",
            "expression": "IF ( [Over (Under) Billing] < 0, \"#C77D0A\", \"#1B2A4A\" )",
            "displayFolder": "6 Status"
          },
          {
            "name": "VAC Heat Color",
            "expression": [
              "VAR v = [Variance at Completion %]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( v ), BLANK (),",
              "        v < -0.10, \"#B83232\",",
              "        v < -0.05, \"#E06666\",",
              "        v < -0.01, \"#F4B6B6\",",
              "        v <= 0.01, \"#E6EBF2\",",
              "        \"#A8DCC0\"",
              "    )"
            ],
            "displayFolder": "6 Status"
          },
          {
            "name": "KPI Contract Sub",
            "expression": "\"Bid \" & FORMAT ( [Original Contract] / 1e6, \"$#,0.0\" ) & \"M + COs \" & FORMAT ( [Approved CO Revenue], \"$#,0,K\" )",
            "displayFolder": "9 Labels"
          },
          {
            "name": "KPI Budget Sub",
            "expression": "\"Bid \" & FORMAT ( [Original Budget] / 1e6, \"$#,0.0\" ) & \"M + COs \" & FORMAT ( [Approved CO Cost], \"$#,0,K\" )",
            "displayFolder": "9 Labels"
          },
          {
            "name": "KPI Actual Sub",
            "expression": "FORMAT ( [% Complete], \"0%\" ) & \" complete (physical)\"",
            "displayFolder": "9 Labels"
          },
          {
            "name": "KPI EAC Sub",
            "expression": [
              "VAR v = [Variance at Completion]",
              "RETURN IF ( v < 0, FORMAT ( -v, \"$#,0,K\" ) & \" over budget\", FORMAT ( v, \"$#,0,K\" ) & \" under budget\" )"
            ],
            "displayFolder": "9 Labels"
          },
          {
            "name": "KPI Margin Sub",
            "expression": "\"Bid margin \" & FORMAT ( [Original Margin %], \"0.0%\" ) & \" (\" & FORMAT ( [Margin Fade (pp)], \"+0.0;-0.0\" ) & \" pp)\"",
            "displayFolder": "9 Labels"
          },
          {
            "name": "KPI CPI Sub",
            "expression": "\"SPI \" & FORMAT ( [SPI], \"0.00\" ) & \" · 1.00 = on plan\"",
            "displayFolder": "9 Labels"
          },
          {
            "name": "KPI Committed Sub",
            "expression": "FORMAT ( [Committed % of Budget], \"0%\" ) & \" of revised budget\"",
            "displayFolder": "9 Labels"
          },
          {
            "name": "KPI Gap Sub",
            "expression": [
              "VAR g = [Forecast Gap]",
              "RETURN IF ( g > 0, FORMAT ( g, \"$#,0,K\" ) & \" above the PM forecast\", FORMAT ( -g, \"$#,0,K\" ) & \" below the PM forecast\" )"
            ],
            "displayFolder": "9 Labels"
          },
          {
            "name": "Title Project",
            "expression": [
              "VAR p = SELECTEDVALUE ( dim_project[project_name], \"Select one project\" )",
              "VAR pm = SELECTEDVALUE ( dim_pm[pm_name] )",
              "VAR st = SELECTEDVALUE ( dim_project[status] )",
              "VAR c = SELECTEDVALUE ( dim_project[client] )",
              "RETURN IF ( HASONEVALUE ( dim_project[project_id] ), p & \"  ·  \" & c & \"  ·  PM \" & pm & \"  ·  \" & st, p )"
            ],
            "displayFolder": "9 Labels"
          },
          {
            "name": "Board Point",
            "expression": [
              "VAR worst = TOPN ( 1, VALUES ( dim_project[project_name] ), [Variance at Completion], ASC )",
              "VAR worstName = MAXX ( worst, dim_project[project_name] )",
              "VAR worstVac = CALCULATE ( [Variance at Completion], worst )",
              "RETURN",
              "    SWITCH (",
              "        SELECTEDVALUE ( board_points[Point] ),",
              "        1, [Projects Over Budget] & \" of \" & [Projects] & \" projects are forecast more than 1% over budget. Largest overrun: \"",
              "            & worstName & \" (\" & FORMAT ( -worstVac, \"$#,0,K\" ) & \").\",",
              "        2, \"Projected margin is \" & FORMAT ( [Projected Margin %], \"0.0%\" ) & \" against \" & FORMAT ( [Original Margin %], \"0.0%\" )",
              "            & \" at bid: \" & FORMAT ( [Projected Gross Profit] / 1e6, \"$#,0.0\" ) & \"M of gross profit on \"",
              "            & FORMAT ( [Revised Contract] / 1e6, \"$#,0.0\" ) & \"M of contracts.\",",
              "        3, \"The CPI trend is \" & FORMAT ( [Forecast Gap], \"$#,0,K\" ) & \" above the PM forecasts, and \"",
              "            & FORMAT ( [Pending CO Price], \"$#,0,K\" ) & \" of change orders still wait for client approval.\"",
              "    )"
            ],
            "displayFolder": "9 Labels"
          }
        ]
      }
    ],
