            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "vendor",
            "dataType": "string",
            "sourceColumn": "vendor",
            "summarizeBy": "none"
          },
          {
            "name": "commitment_date",
            "dataType": "dateTime",
